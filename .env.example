# CinePose Environment Configuration
# Copy this file to .env and fill in your values

# Supabase Configuration (required for auth & storage)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic Claude API Key (required for AI scene analysis & pose tips)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Upstash Redis (optional, for rate limiting)
UPSTASH_REDIS_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token

# Site URL (for auth redirects & SEO)
SITE_URL=http://localhost:4321
