---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Color Studio">
  <main class="px-4 pt-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-bold text-[#F9FAFB]">Color Studio</h1>
      <button class="px-4 py-2 rounded-full bg-[#A78BFA] text-white text-xs font-medium">Export</button>
    </div>

    <!-- Viewer -->
    <div class="aspect-[3/4] rounded-2xl bg-[#111827] mb-4 flex items-center justify-center overflow-hidden border border-white/5">
      <div class="text-center p-8">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.5" class="mx-auto mb-3">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <path d="M21 15l-5-5L5 21" />
        </svg>
        <p class="text-sm text-[#6B7280] mb-2">Import a photo to start grading</p>
        <button class="px-4 py-2 rounded-full bg-white/5 text-xs text-[#F9FAFB] border border-white/10">Import from Gallery</button>
      </div>
    </div>

    <!-- Quick Tools -->
    <div class="space-y-3">
      {['Exposure', 'Contrast', 'Saturation', 'Temperature', 'Vignette'].map((control) => (
        <div key={control} class="flex items-center gap-3">
          <span class="text-xs text-[#6B7280] w-20">{control}</span>
          <input type="range" min="0" max="100" value="50" class="flex-1" />
          <span class="text-xs text-[#F9FAFB] w-8 text-right">50</span>
        </div>
      ))}
    </div>

    <!-- LUT Presets -->
    <div class="mt-6">
      <h2 class="text-sm font-semibold text-[#F9FAFB] mb-3">LUT Presets</h2>
      <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
        {['Revenant', 'Hollywood', 'Golden Hour', 'Blue Hour', 'Moody B&W', 'Fuji X-Pro', 'Kodak Vision', 'Neon Tokyo'].map((lut) => (
          <button key={lut} class="flex-shrink-0 px-4 py-2 rounded-xl bg-white/5 text-xs text-[#F9FAFB] border border-white/10 hover:bg-white/10 transition-colors">
            {lut}
          </button>
        ))}
      </div>
    </div>
  </main>
</AppLayout>
