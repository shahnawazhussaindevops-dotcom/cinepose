---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { POSES } from '../../components/pose/PoseLibrary';

export const prerender = true;

export function getStaticPaths() {
  return POSES.map((pose) => ({
    params: { id: pose.name.toLowerCase().replace(/\s+/g, '-') },
    props: { pose },
  }));
}

const { pose } = Astro.props;
---

<BaseLayout title={`${pose.name} — CinePose Pose Guide`}>
  <main class="min-h-screen px-4 pt-8 pb-24">
    <a href="/poses" class="inline-flex items-center gap-1 text-sm text-[#6B7280] hover:text-[#F9FAFB] mb-6 transition-colors">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
      Back to Poses
    </a>

    <div class="aspect-[3/4] rounded-2xl bg-[#111827] mb-6 flex items-center justify-center overflow-hidden border border-white/5">
      <div class="text-center">
        <div class="w-24 h-48 mx-auto rounded-2xl bg-gradient-to-b from-[#A78BFA]/20 to-[#6EE7B7]/10 flex items-center justify-center mb-4">
          <svg width="40" height="60" viewBox="0 0 24 36" fill="none" stroke="#A78BFA" stroke-width="1" opacity="0.5">
            <circle cx="12" cy="4" r="3" />
            <path d="M12 7v6" />
            <path d="M8 16l-3 6" />
            <path d="M16 16l3 6" />
            <path d="M12 13l-4 6" />
            <path d="M12 13l4 6" />
            <path d="M9 19l3-2 3 2" />
          </svg>
        </div>
        <h1 class="text-xl font-bold text-[#F9FAFB] mb-1">{pose.name}</h1>
        <p class="text-sm text-[#6B7280] capitalize">{pose.category}</p>
      </div>
    </div>

    <div class="space-y-4">
      <div class="glass rounded-2xl p-4">
        <h2 class="text-sm font-semibold text-[#F9FAFB] mb-2">Description</h2>
        <p class="text-sm text-[#6B7280]">{pose.description}</p>
      </div>

      {pose.tip && (
        <div class="glass rounded-2xl p-4 border-l-2 border-[#A78BFA]">
          <h2 class="text-sm font-semibold text-[#A78BFA] mb-1">Pro Tip</h2>
          <p class="text-sm text-[#A78BFA]/80">{pose.tip}</p>
        </div>
      )}

      <div class="glass rounded-2xl p-4">
        <h2 class="text-sm font-semibold text-[#F9FAFB] mb-3">Works best for</h2>
        <div class="flex flex-wrap gap-2">
          {pose.scenes.map((scene) => (
            <span class="px-2.5 py-1 rounded-full bg-white/5 text-xs text-[#6B7280]">{scene}</span>
          ))}
        </div>
      </div>

      {pose.score && (
        <div class="glass rounded-2xl p-4 text-center">
          <span class="text-sm text-[#6EE7B7] font-medium">{pose.score}</span>
        </div>
      )}

      <a href={`/camera?pose=${pose.id}`} class="block w-full py-3 text-center rounded-full bg-[#A78BFA] text-white font-semibold hover:bg-[#9678E8] transition-colors">
        Try This Pose
      </a>
    </div>
  </main>
</BaseLayout>
