---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CinePose — Ultra AI Cinema Camera">
  <main class="min-h-screen bg-[#0D0D1A] bg-grid">
    <!-- Hero -->
    <section class="relative min-h-screen flex flex-col items-center justify-center px-6 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#A78BFA]/10 via-transparent to-[#0D0D1A] pointer-events-none" />
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-[#A78BFA]/5 rounded-full blur-[120px] pointer-events-none" />
      <div class="absolute bottom-1/4 right-0 w-[400px] h-[400px] bg-[#6EE7B7]/5 rounded-full blur-[100px] pointer-events-none" />
      
      <!-- Scanline overlay -->
      <div class="absolute inset-0 pointer-events-none opacity-[0.03]" style="background: repeating-linear-gradient(0deg, transparent, transparent 2px, white 2px, white 4px);" />

      <nav class="absolute top-0 left-0 right-0 flex items-center justify-between px-6 py-5 animate-fade-down">
        <div class="flex items-center gap-2">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-[#A78BFA] to-[#6EE7B7] flex items-center justify-center shadow-[0_0_20px_rgba(167,139,250,0.3)]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
              <path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z" />
              <circle cx="12" cy="13" r="4" />
            </svg>
          </div>
          <span class="font-bold text-lg text-transparent bg-clip-text bg-gradient-to-r from-[#A78BFA] to-[#6EE7B7]">CinePose</span>
        </div>
        <div class="flex items-center gap-3">
          <a href="/camera" class="px-5 py-2.5 rounded-full bg-gradient-to-r from-[#A78BFA] to-[#7C3AED] text-white text-sm font-medium hover:opacity-90 transition-all neon-glow">
            Launch App
          </a>
        </div>
      </nav>

      <div class="relative z-10 text-center max-w-4xl">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 mb-6 animate-fade-up animate-stagger-1">
          <span class="w-2 h-2 rounded-full bg-[#6EE7B7] animate-pulse" />
          <span class="text-xs text-[#6B7280] font-mono tracking-wider">12 AI AGENTS · HOLLYWOOD CINEMA · ON-DEVICE</span>
        </div>

        <h1 class="text-5xl md:text-7xl font-bold leading-tight mb-6 animate-fade-up animate-stagger-2">
          <span class="text-[#F9FAFB]">Your pocket</span>
          <br />
          <span class="text-gradient">Hollywood director.</span>
        </h1>

        <p class="text-lg text-[#6B7280] max-w-xl mx-auto mb-10 leading-relaxed animate-fade-up animate-stagger-3">
          CinePose Ultra AI turns your smartphone into a complete film studio.
          12 AI agents work together — photographer, cinematographer, stylist, director, and more.
        </p>

        <div class="flex items-center justify-center gap-4 animate-fade-up animate-stagger-4">
          <a href="/camera" class="px-8 py-3.5 rounded-full bg-gradient-to-r from-[#A78BFA] to-[#7C3AED] text-white font-semibold text-base hover:opacity-90 transition-all neon-glow inline-flex items-center gap-2 group">
            Open Camera
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/20 animate-fade-up animate-stagger-5">
        <span class="text-xs font-mono tracking-widest">EXPLORE 12 AI AGENTS</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="animate-bounce">
          <path d="M12 5v14M19 12l-7 7-7-7" />
        </svg>
      </div>
    </section>

    <!-- 12 AI Agents -->
    <section class="px-6 py-24 max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-[#F9FAFB] mb-4 animate-fade-up">12 AI Agents. One Camera.</h2>
        <p class="text-[#6B7280] max-w-lg mx-auto animate-fade-up animate-stagger-1">Every CinePose Ultra AI feature works together in real-time to help you capture cinematic photos and videos.</p>
      </div>

      <div class="grid md:grid-cols-3 lg:grid-cols-4 gap-4">
        {[
          { icon: '📸', title: 'AI Photographer', desc: 'Live pose guidance, composition scoring, eye/blur detection. Auto burst and best-shot selection.', color: '#A78BFA' },
          { icon: '🎬', title: 'AI Cinematographer', desc: 'Shot type recommendations, camera movements, shot lists. Live direction for every scene.', color: '#6EE7B7' },
          { icon: '👔', title: 'AI Outfit Analyzer', desc: 'Detects your location and recommends colors, outfits, accessories, and footwear.', color: '#FB923C' },
          { icon: '📍', title: 'AI Location Intel', desc: 'Beach, mountain, city, luxury property — 7 score categories, weather, best shooting time.', color: '#60A5FA' },
          { icon: '🎯', title: 'Director Vision', desc: 'Analyzes foreground, depth, color palette, atmosphere. Visual storytelling potential.', color: '#A78BFA' },
          { icon: '🌟', title: 'Hollywood Director', desc: '14 scene types. Step-by-step direction: camera, expression, movement, duration.', color: '#6EE7B7' },
          { icon: '💬', title: 'CineGPT', desc: 'Ask anything: posing, outfits, lighting, angles, color grading. Your AI photography coach.', color: '#FB923C' },
          { icon: '🎞️', title: 'AI Reel Generator', desc: 'Auto-generates shot sequences, transitions, music, text overlays for social media reels.', color: '#60A5FA' },
          { icon: '🔬', title: 'Master Scene Analyzer', desc: 'Full scene analysis: pose, angle, lens, LUT, storytelling concept, reel idea.', color: '#A78BFA' },
          { icon: '📈', title: 'Trend Integration', desc: 'Instagram & Pinterest trending poses, hashtags, styles. Always stay on trend.', color: '#F472B6' },
          { icon: '👻', title: 'AR Pose Projection', desc: 'Holographic pose overlay on your camera. Match the guide in real time.', color: '#6EE7B7' },
          { icon: '🧬', title: 'AI Human Clone', desc: '3D preview with pose simulation, outfit testing, and camera angle preview.', color: '#A78BFA' },
        ].map((feature, idx) => (
          <div class={`glass rounded-2xl p-4 hover:border-white/20 transition-all hover:translate-y-[-4px] hover:shadow-[0_0_30px_rgba(167,139,250,0.1)] animate-fade-up animate-stagger-${Math.min(idx + 1, 8)}`}>
            <span class="text-2xl mb-2 block">{feature.icon}</span>
            <h3 class="text-sm font-semibold text-[#F9FAFB] mb-1">{feature.title}</h3>
            <p class="text-[11px] text-[#6B7280] leading-relaxed">{feature.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Features Grid -->
    <section class="px-6 py-20 bg-[#0D0D1A]/50">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-[#F9FAFB] mb-4 animate-fade-up">Everything you need</h2>
          <p class="text-[#6B7280] max-w-lg mx-auto animate-fade-up animate-stagger-1">Professional tools that were once exclusive to Hollywood post-production.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {[
            { icon: '✦', title: 'Cinematic LUT Engine', desc: 'DaVinci-quality color grading. 15+ presets. WebGL-powered real-time preview.', color: '#A78BFA' },
            { icon: '⊹', title: '3D Pose Robot', desc: 'Humanoid hologram guide. Spring animations. Gender-variant proportions.', color: '#6EE7B7' },
            { icon: '☀', title: 'Smart Lighting', desc: '9-zone metering, 11-class classifier, golden hour tracking.', color: '#FB923C' },
            { icon: '◎', title: 'Drone Simulator', desc: 'Aerial framing, cinematic patterns, 5-keyframe capture.', color: '#60A5FA' },
            { icon: '◈', title: 'Pro Color Studio', desc: 'DaVinci-style grading. .cube LUT export. Full scopes.', color: '#A78BFA' },
            { icon: '🔒', title: 'Privacy First', desc: 'All AI on-device. No uploads. Zero data leakage. Designed for trust.', color: '#6EE7B7' },
          ].map((feature, idx) => (
            <div class={`glass rounded-2xl p-6 hover:border-white/20 transition-all hover:translate-y-[-2px] animate-fade-up animate-stagger-${Math.min(idx + 1, 8)}`}>
              <span class="text-3xl mb-4 block" style={{ color: feature.color }}>{feature.icon}</span>
              <h3 class="text-lg font-semibold text-[#F9FAFB] mb-2">{feature.title}</h3>
              <p class="text-sm text-[#6B7280] leading-relaxed">{feature.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-6 py-24 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-[#A78BFA]/5 via-transparent to-[#6EE7B7]/5 pointer-events-none" />
      <div class="max-w-lg mx-auto relative z-10">
        <h2 class="text-3xl font-bold text-[#F9FAFB] mb-4 animate-fade-up">Ready to create cinema?</h2>
        <p class="text-[#6B7280] mb-8 animate-fade-up animate-stagger-1">No sign up required. No cloud uploads. Just you and 12 AI agents.</p>
        <a href="/camera" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-gradient-to-r from-[#A78BFA] to-[#7C3AED] text-white font-semibold hover:opacity-90 transition-all neon-glow group animate-fade-up animate-stagger-2">
          Launch CinePose Ultra
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="px-6 py-10 text-center border-t border-white/5">
      <div class="flex items-center justify-center gap-2 mb-3">
        <div class="w-6 h-6 rounded-lg bg-gradient-to-br from-[#A78BFA] to-[#6EE7B7] shadow-[0_0_15px_rgba(167,139,250,0.3)]" />
        <span class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#A78BFA] to-[#6EE7B7]">CinePose</span>
      </div>
      <p class="text-xs text-[#6B7280] font-mono tracking-wider">YOUR POCKET HOLLYWOOD DIRECTOR.</p>
      <p class="text-[10px] text-[#4B5563] mt-2">2026 CinePose. All rights reserved.</p>
    </footer>
  </main>
</BaseLayout>
