---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CinePose — AI Cinematic Camera">
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative min-h-screen flex flex-col items-center justify-center px-6 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#A78BFA]/10 via-transparent to-[#0D0D1A] pointer-events-none" />
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-[#A78BFA]/5 rounded-full blur-[100px] pointer-events-none" />

      <nav class="absolute top-0 left-0 right-0 flex items-center justify-between px-6 py-5">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-[#A78BFA] to-[#6EE7B7] flex items-center justify-center">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
              <path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z" />
              <circle cx="12" cy="13" r="4" />
            </svg>
          </div>
          <span class="font-bold text-lg text-[#F9FAFB]">CinePose</span>
        </div>
        <div class="flex items-center gap-3">
          <a href="/camera" class="text-sm text-[#6B7280] hover:text-[#F9FAFB] transition-colors">Launch App</a>
          <a href="/camera" class="px-4 py-2 rounded-full bg-[#A78BFA] text-white text-sm font-medium hover:bg-[#9678E8] transition-colors glow-violet">
            Get Started
          </a>
        </div>
      </nav>

      <div class="relative z-10 text-center max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 mb-6">
          <span class="w-2 h-2 rounded-full bg-[#6EE7B7]" />
          <span class="text-xs text-[#6B7280]">AI-Powered Cinematic Camera</span>
        </div>

        <h1 class="text-5xl md:text-7xl font-bold leading-tight mb-6">
          <span class="text-[#F9FAFB]">See the shot</span>
          <br />
          <span class="text-gradient">before you take it.</span>
        </h1>

        <p class="text-lg text-[#6B7280] max-w-xl mx-auto mb-10 leading-relaxed">
          The world's first AI camera with a 3D humanoid pose guide.
          Real-time cinematic LUTs, smart lighting analysis, and drone simulation
          — all on-device, privacy-first.
        </p>

        <div class="flex items-center justify-center gap-4">
          <a
            href="/camera"
            class="px-8 py-3.5 rounded-full bg-[#A78BFA] text-white font-semibold text-base hover:bg-[#9678E8] transition-all glow-violet inline-flex items-center gap-2"
          >
            Open Camera
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href="/poses"
            class="px-8 py-3.5 rounded-full bg-white/5 text-[#F9FAFB] font-semibold text-base border border-white/10 hover:bg-white/10 transition-all inline-flex items-center gap-2"
          >
            Browse Poses
          </a>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/30">
        <span class="text-xs">Explore</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="animate-bounce">
          <path d="M12 5v14M19 12l-7 7-7-7" />
        </svg>
      </div>
    </section>

    <!-- Features Section -->
    <section class="px-6 py-24 max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-[#F9FAFB] mb-4">
          Everything you need for the perfect shot
        </h2>
        <p class="text-[#6B7280] max-w-lg mx-auto">
          Professional-grade tools that were once exclusive to Hollywood post-production studios.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          { icon: '✦', title: 'Cinematic LUT Engine', desc: 'DaVinci Resolve-quality color grading with 15+ presets. WebGL-powered, zero latency.', color: '#A78BFA' },
          { icon: '⊹', title: 'AI Pose Robot', desc: '3D humanoid hologram that shows you the perfect pose for any scene. 20+ cinematic poses.', color: '#6EE7B7' },
          { icon: '☀', title: 'Smart Lighting Analysis', desc: 'Real-time light metering with golden hour tracking and actionable suggestions.', color: '#FB923C' },
          { icon: '◎', title: 'Drone Shot Simulator', desc: 'Aerial framing guides and cinematic movement paths without leaving the ground.', color: '#60A5FA' },
          { icon: '◈', title: 'Pro Color Studio', desc: 'Full DaVinci-style grading with scopes, curves, and .cube LUT export.', color: '#A78BFA' },
          { icon: '🔒', title: 'Privacy First', desc: 'All AI runs on-device. No images uploaded. Zero data leakage. Designed for trust.', color: '#6EE7B7' },
        ].map((feature) => (
          <div class="glass rounded-2xl p-6 hover:border-white/20 transition-all">
            <span class="text-3xl mb-4 block" style={{ color: feature.color }}>{feature.icon}</span>
            <h3 class="text-lg font-semibold text-[#F9FAFB] mb-2">{feature.title}</h3>
            <p class="text-sm text-[#6B7280] leading-relaxed">{feature.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Security Section -->
    <section class="px-6 py-20 bg-[#0D0D1A]/50">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-[#F9FAFB] mb-6">
          Built for privacy. Designed for trust.
        </h2>
        <div class="grid md:grid-cols-3 gap-6 mt-10">
          {[
            { title: 'On-Device AI', desc: 'All TensorFlow.js models run locally. Zero images leave your device.' },
            { title: 'No Analytics', desc: 'No tracking SDKs. No telemetry by default. Optional crash reports only.' },
            { title: 'End-to-End Secure', desc: 'HTTPS everywhere, CSP headers, certificate pinning, and Supabase RLS.' },
          ].map((item) => (
            <div class="p-4">
              <div class="w-12 h-12 rounded-full bg-[#A78BFA]/10 flex items-center justify-center mx-auto mb-4">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A78BFA" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                  <path d="M7 11V7a5 5 0 0110 0v4" />
                </svg>
              </div>
              <h3 class="text-base font-semibold text-[#F9FAFB] mb-2">{item.title}</h3>
              <p class="text-sm text-[#6B7280]">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="px-6 py-10 text-center">
      <div class="flex items-center justify-center gap-2 mb-3">
        <div class="w-5 h-5 rounded bg-gradient-to-br from-[#A78BFA] to-[#6EE7B7]" />
        <span class="font-bold text-[#F9FAFB]">CinePose</span>
      </div>
      <p class="text-xs text-[#6B7280]">See the shot before you take it.</p>
      <p class="text-[10px] text-[#4B5563] mt-2">2026 CinePose. All rights reserved.</p>
    </footer>
  </main>
</BaseLayout>
